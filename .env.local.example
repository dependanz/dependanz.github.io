# Copy to .env.local for local dev (.env.local is gitignored).
# These are NEXT_PUBLIC_* so they are inlined into the build at build time. In production the VPS
# holds its own .env.local (never committed); the deploy hook's `npm run build` inlines these —
# see DEPLOY.md, Phase 5. The Supabase anon key is public-safe by design.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# From your Prolific study's completion code (Study settings -> "Completion codes").
NEXT_PUBLIC_PROLIFIC_COMPLETION_URL=https://app.prolific.com/submissions/complete?cc=REPLACE_ME
