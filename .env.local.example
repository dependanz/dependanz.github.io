# Copy to .env.local for local dev (.env.local is gitignored).
# These are NEXT_PUBLIC_* so they are inlined into the static build — for production
# on GitHub Pages you must also inject them in the Actions build step (see
# app/surveys/evc-pilot/SETUP.md). The Supabase anon key is public-safe by design.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# From your Prolific study's completion code (Study settings -> "Completion codes").
NEXT_PUBLIC_PROLIFIC_COMPLETION_URL=https://app.prolific.com/submissions/complete?cc=REPLACE_ME
