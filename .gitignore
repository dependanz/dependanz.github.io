# Node modules
node_modules/

# Next.js build output
.next/
out/

# kuromoji dictionary — regenerated from node_modules by scripts/copy-kuromoji-dict.mjs (postinstall)
public/kuromoji-dict/

# Plaintext blog drafts — NEVER commit these. Only their encrypted form (public/drafts/*.enc.json,
# produced by scripts/encrypt.mjs) is committed and deployed.
drafts-src/

# Master key for encrypting protected content — NEVER commit. Local to this machine only.
.master-key

# Optional npm cache directory
.npm/

# Debug log files
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment variables
.env.local
.env.development.local
.env.test.local
.env.production.local

# Operating System files
.DS_Store
Thumbs.db

# Editor directories and files
.vscode/
.idea/

# Claude Code — local agent tooling / machine-specific settings (public repo: keep out)
.claude/
